# ── Environment ───────────────────────────────────────────────────────────────
# "production" restricts CORS to FRONTEND_ORIGIN only; anything else (default
# "development") also allows the localhost Vite dev/preview origins.
ENVIRONMENT=development

# Allowed browser origin for CORS (the deployed frontend), if any.
FRONTEND_ORIGIN=

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Cheap/fast model used for the input guard (chitchat/refuse/data_query triage).
GUARD_MODEL=llama-3.1-8b-instant

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret used to sign access tokens. MUST be a long random string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Seed admin account, created by db/setup_postgres.py on first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Redis (Blackboard) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Seconds before an in-flight query entry auto-expires (prevents dead-agent stalls)
QUERY_TTL_SECONDS=120

# Seconds to keep completed results in cache
RESULT_CACHE_TTL_SECONDS=3600

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# DSN for the unified database. Matches docker-compose.yml's defaults — run
# `docker compose up -d` to start a local Postgres, then `python
# db/setup_postgres.py` to create the schema.
DATABASE_URL=postgresql://arshmank:arshmank@localhost:5432/sql_agents

# Optional artificial per-query latency in ms, for benchmarking (default 0).
DB_LATENCY_MS=0

# ── Schema Index ──────────────────────────────────────────────────────────────
# Path where the FAISS index will be stored/loaded
SCHEMA_INDEX_PATH=./schema_index

# Number of relevant tables to retrieve per agent task
SCHEMA_TOP_K=5

# Embedding model for schema retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── File & Document Uploads ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
DOCUMENT_INDEX_PATH=./document_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
FILE_SEARCH_TOP_DOCS=3
FILE_SEARCH_TOP_CHUNKS=5
UPLOADS_DOMAIN=uploads
